# ===========================================
# LiveMap Client Environment Variables
# ===========================================
# Copy to .env.local for local development

# Backend API (FastAPI). Unset -> the map shows bundled sample data.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010/api/v1

# Database shared with the backend (NextAuth users). Neon pooled URL works on Vercel.
DATABASE_URL=postgresql://livemap:livemap123@localhost:5432/livemap

# NextAuth — must equal AUTH_SECRET in backend/.env
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_secret_here
# Needed for `next start` outside Vercel (Vercel trusts its host automatically)
# AUTH_TRUST_HOST=true

# Default account prefilled on the sign-in form (created automatically on first login)
DEMO_USER_EMAIL=abc@gmail.com
DEMO_USER_PASSWORD=password1234

# Optional OAuth providers (buttons appear only when set)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=

# Optional Sentry
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
