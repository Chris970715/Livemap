# ===========================================
# Huginn Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# Application
APP_NAME=Livemap API
DEBUG=False

# ===========================================
# Database (PostgreSQL + pgvector)
# ===========================================
DATABASE_URL=postgresql+asyncpg://livemap:your_password@localhost:5432/livemap

# ===========================================
# Authentication (REQUIRED)
# ===========================================
# MUST match the AUTH_SECRET in the frontend's .env file
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_secret_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Publishable Criteria
PUBLISHABLE_MIN_CREDIBILITY=60
PUBLISHABLE_REQUIRE_LOCATION=false

# ===========================================
# LLM Settings (Cost-Optimized: Free Tier)
# ===========================================

# Groq API (무료: 14,400 RPD) — 분류/검증용
# https://console.groq.com/
AGENT_GROQ_API_KEY=gsk_your-groq-key-here
AGENT_GROQ_MODEL=llama-3.1-8b-instant

# Gemini API (무료: 1,000 RPD) — 기사 생성용
# https://aistudio.google.com/
AGENT_GEMINI_API_KEY=your-gemini-key-here
AGENT_GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI API Key (폴백용, 선택)
# https://platform.openai.com/
AGENT_OPENAI_API_KEY=
AGENT_LLM_MODEL=gpt-4o-mini

# Tavily API (Free: 1,000/month) — 증거 검색용
# https://tavily.com/
AGENT_TAVILY_API_KEY=tvly-your-key-here

# ===========================================
# News Sources
# ===========================================
AGENT_GDELT_ENABLED=true
AGENT_GDELT_TIMESPAN=60min

# ===========================================
# Scanner Settings
# ===========================================
AGENT_SCAN_INTERVAL_MINUTES=60
